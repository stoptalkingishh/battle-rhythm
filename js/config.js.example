"use strict";
/* Google Drive backup configuration - TEMPLATE.
 *
 * TEMPLATE. You do not normally fill this in by hand: js/config.js is tracked
 * with both values empty, and the deploy job runs scripts/write-config.mjs to
 * write a populated copy into the published artifact using the
 * BR_GOOGLE_CLIENT_ID repository secret and the BR_DRIVE_TOKEN_PROXY
 * repository variable. scripts/check-config.mjs fails the build if the tracked
 * js/config.js becomes populated.
 *
 *   BR_GOOGLE_CLIENT_ID
 *     OAuth 2.0 Client ID of type "Web application", from
 *     https://console.cloud.google.com/apis/credentials
 *     Must list this site's origin (https://stoptalkingishh.github.io) under
 *     "Authorized JavaScript origins" AND this page's full URL
 *     (https://stoptalkingishh.github.io/battle-rhythm/) under "Authorized
 *     redirect URIs". Sign-in redirects back here with an authorization code,
 *     so a missing redirect URI fails with redirect_uri_mismatch.
 *     Shape: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
 *
 *   BR_DRIVE_TOKEN_PROXY
 *     The /exec URL of the Apps Script token proxy in
 *     scripts/drive-token-proxy.gs, deployed as a Web App. It holds the OAuth
 *     client SECRET (in Script Properties) and performs the code-for-token
 *     exchange and the refresh exchange, because Google refuses a secret-less
 *     token request: its discovery document advertises only
 *     client_secret_post and client_secret_basic.
 *     Shape: https://script.google.com/macros/s/AKfy.../exec
 *
 * Both are public identifiers that ship in the page; the client id is not a
 * secret and the proxy URL is only an address. The Drive scope requested is
 * drive.file, which reaches only files this app creates, and access is granted
 * by the signed-in user. Never put the client secret in this file.
 */
window.BR_GOOGLE_CLIENT_ID = "";
window.BR_DRIVE_TOKEN_PROXY = "";
