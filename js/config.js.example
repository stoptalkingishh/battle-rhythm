"use strict";
/* Google Drive backup configuration — TEMPLATE.
 *
 * MOST USERS DO NOT NEED THIS FILE. Battle Rhythm's Settings tab has a
 * self-service setup flow (Settings > Google Drive backup > Set up Google
 * Drive) that walks through the Google Cloud console and stores both values in
 * this browser's localStorage. Leave this file as it is and use that.
 * See docs/google-drive-setup.md.
 *
 * This template is for self-hosters who want Drive backup on for every visitor
 * with no setup step. Copy this file to js/config.js and fill in the two
 * values. js/config.js is tracked in git, so add it to .git/info/exclude
 * (or .gitignore in a fork) before filling it in; CI
 * (scripts/check-config.mjs) fails the build if either value is committed, and
 * now also scans the rest of js/ and tests/ for a hard-coded key.
 *
 * A build with a populated js/config.js takes priority over anything a visitor
 * saved in their own browser, so a local paste cannot override it.
 *
 *   BR_GOOGLE_CLIENT_ID
 *     OAuth 2.0 Client ID of type "Web application", from
 *     https://console.cloud.google.com/apis/credentials
 *     The client must list this site's origin (e.g.
 *     https://stoptalkingishh.github.io) under "Authorized JavaScript origins",
 *     or Google will reject the sign-in.
 *     Shape: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
 *
 *   BR_GOOGLE_API_KEY
 *     API key from the same console, created with the Google Drive API enabled.
 *     Restrict it to the Drive API and to this site's referrer.
 *     Shape: AIzaSyAbCdEfGhIjKlMnOpQrStUvWxYz1234567
 *
 * Both are public client-side identifiers: they are embedded in the page and
 * readable by anyone who views source. That is expected and is the same model
 * openquiz uses with its NEXT_PUBLIC_GOOGLE_* values. The OAuth client id is
 * not a secret, and the API key is only a rate-limit and quota control rather
 * than an access control — restrict it by API and referrer, do not rely on it
 * to keep data private. Access itself is granted by the signed-in user, and
 * the Drive scope requested is drive.file, which only reaches files this app
 * creates.
 */
window.BR_GOOGLE_CLIENT_ID = "";
window.BR_GOOGLE_API_KEY = "";
/* After changing either value, run `npm run bump:bust` so browsers that have a
 * cached copy of js/config.js pick the change up. */
